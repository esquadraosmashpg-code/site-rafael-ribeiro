GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_ID=
GOOGLE_REFRESH_TOKEN=
GOOGLE_REDIRECT_URI=https://site-rafael-ribeiro.vercel.app/api/google/callback
GOOGLE_TIMEZONE=America/Sao_Paulo

# Deixe "true" APENAS na Vercel (nunca localmente -- o redirect autorizado
# no Google Cloud e a URL de producao) e so durante a janela de gerar o
# GOOGLE_REFRESH_TOKEN (ver README.md > "Agenda própria"). Fora disso,
# deixe vazio/ausente -- com qualquer valor diferente de "true" as rotas
# /api/google/authorize e /api/google/callback respondem 404.
GOOGLE_OAUTH_SETUP_ENABLED=

# Notificação por e-mail pro profissional a cada agendamento novo.
# DESATIVADA por padrão -- só liga com "true" nas duas linhas abaixo
# preenchidas. Integração de envio ainda está pendente (nenhum provedor
# de e-mail configurado neste projeto) -- ver
# lib/notifications/professionalNotification.js. Nunca hardcode o e-mail
# no código: ele só existe aqui, como variável de ambiente.
PROFESSIONAL_NOTIFICATION_ENABLED=
PROFESSIONAL_NOTIFICATION_EMAIL=

# ---------------------------------------------------------------------
# Reserva provisória com Pix + confirmação manual (ver README.md >
# "Reserva provisória com Pix"). Todas as variáveis abaixo usam serviços
# gratuitos (Supabase free tier) -- nenhuma delas exige cartão de crédito.
# ---------------------------------------------------------------------

# Supabase (Postgres + PostgREST) -- projeto free tier. URL do projeto
# (ex.: https://xxxxx.supabase.co) e a service_role key (Settings > API).
# SUPABASE_SERVICE_ROLE_KEY NUNCA pode ter o prefixo NEXT_PUBLIC_ (isso a
# exporia ao navegador) -- ela dá acesso total ao banco, ignorando RLS.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Senha do painel /admin/agendamentos e segredo usado pra assinar o
# cookie de sessão administrativa (HMAC-SHA256). Gere um valor aleatório
# longo pro segredo -- nunca reaproveite a senha do painel como segredo.
# BOOKING_ADMIN_SESSION_SECRET precisa ter PELO MENOS 32 caracteres --
# abaixo disso, o login recusa (503) em vez de assinar sessões com um
# segredo fraco/forjável. Gere com, por exemplo:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BOOKING_ADMIN_PASSWORD=
BOOKING_ADMIN_SESSION_SECRET=

# Dados do Pix mostrados na tela de reserva. Enquanto BOOKING_PIX_KEY
# estiver vazio, a tela nunca mostra uma chave falsa -- avisa que a
# configuração está pendente.
BOOKING_PIX_KEY=
BOOKING_PIX_RECEIVER=

# Número de WhatsApp (só dígitos, com DDI+DDD, ex.: 5511999998888) usado
# no botão "Enviar comprovante pelo WhatsApp".
BOOKING_WHATSAPP_NUMBER=

# Quantos minutos o horário fica reservado provisoriamente aguardando o
# comprovante do sinal. Regra comercial confirmada: 30.
BOOKING_HOLD_MINUTES=30
