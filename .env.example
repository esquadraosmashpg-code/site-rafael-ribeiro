GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_ID=
GOOGLE_REFRESH_TOKEN=
GOOGLE_REDIRECT_URI=https://site-rafael-ribeiro.vercel.app/api/google/callback
GOOGLE_TIMEZONE=America/Sao_Paulo

# Deixe "true" APENAS na Vercel (nunca localmente -- o redirect autorizado
# no Google Cloud e a URL de producao) e so durante a janela de gerar o
# GOOGLE_REFRESH_TOKEN (ver README.md > "Agenda própria"). Fora disso,
# deixe vazio/ausente -- com qualquer valor diferente de "true" as rotas
# /api/google/authorize e /api/google/callback respondem 404.
GOOGLE_OAUTH_SETUP_ENABLED=
